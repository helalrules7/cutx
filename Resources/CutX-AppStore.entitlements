<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required by the App Store; must match the provisioning profile exactly. -->
    <key>com.apple.application-identifier</key>
    <string>T958VWM76Z.com.helalrules.CutX</string>
    <key>com.apple.developer.team-identifier</key>
    <string>T958VWM76Z</string>

    <!-- App Sandbox is mandatory for the store. Verified to still permit the
         CGEventTap once the user grants Accessibility. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
</dict>
</plist>
